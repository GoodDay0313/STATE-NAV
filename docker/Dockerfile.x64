FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

ARG ROS_DISTRO=humble
ARG RMW_NAME=cyclonedds

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    TZ=Etc/UTC \
    PYTHONUNBUFFERED=1 \
    ROS_DISTRO=${ROS_DISTRO} \
    RMW_IMPLEMENTATION=rmw_${RMW_NAME}_cpp \
    ROS_DOMAIN_ID=0

# System deps (+ Qt/X11 runtime for matplotlib QtAgg / PyQt5)
RUN apt-get update && apt-get install -y --no-install-recommends \
        locales \
        tzdata \
        curl \
        gnupg2 \
        lsb-release \
        git \
        python3-pip \
        libgl1-mesa-glx \
        libxkbcommon-x11-0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-randr0 \
        libxcb-render-util0 \
        libxcb-shape0 \
        libxcb-xfixes0 \
        libxcb-xinerama0 \
        libxcb-cursor0 \
    && locale-gen ${LANG} \
    && ln -fs /usr/share/zoneinfo/${TZ} /etc/localtime \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ROS2 base + runtime deps for statenav_global / elevation_mapping_cupy.
# Mounted workspace overlays provide custom msgs (e.g. elevation_map_msgs) and
# ros2_numpy (no humble apt package — build from source in core_ws).
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
        | tee /etc/apt/sources.list.d/ros2.list > /dev/null \
    && apt-get update && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-ros-base \
        ros-${ROS_DISTRO}-rmw-${RMW_NAME}-cpp \
        ros-${ROS_DISTRO}-grid-map-msgs \
        ros-${ROS_DISTRO}-nav-msgs \
        ros-${ROS_DISTRO}-tf-transformations \
        ros-${ROS_DISTRO}-tf2-ros \
        ros-${ROS_DISTRO}-tf2-geometry-msgs \
        ros-${ROS_DISTRO}-sensor-msgs \
        ros-${ROS_DISTRO}-std-srvs \
        ros-${ROS_DISTRO}-message-filters \
        ros-${ROS_DISTRO}-image-transport \
        ros-${ROS_DISTRO}-cv-bridge \
        ros-${ROS_DISTRO}-ament-index-python \
        ros-${ROS_DISTRO}-rosbag2 \
        ros-${ROS_DISTRO}-rviz2 \
        ros-${ROS_DISTRO}-grid-map-rviz-plugin \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# statenav setup deps
RUN python3 -m pip install -U pip wheel setuptools
RUN python3 -m pip install pyyaml "black==21.12b0" unidiff "uvloop==0.17.0"

# Torch CUDA wheels first, then remaining requirements.txt deps
RUN python3 -m pip install -U \
        --index-url https://download.pytorch.org/whl/cu128 \
        --extra-index-url https://pypi.org/simple \
        torch torchvision torchaudio

COPY requirements.txt /tmp/requirements.txt
# --ignore-installed: apt/distutils packages (e.g. transforms3d) cannot be uninstalled by pip
RUN python3 -m pip install -U \
        --ignore-installed \
        --index-url https://download.pytorch.org/whl/cu128 \
        --extra-index-url https://pypi.org/simple \
        -r /tmp/requirements.txt

RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /etc/bash.bashrc

CMD ["/bin/bash"]